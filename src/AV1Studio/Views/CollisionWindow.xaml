<Window x:Class="AV1Studio.Views.CollisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output files already exist — AV1 Studio" Icon="pack://application:,,,/AV1Studio;component/Assets/av1studio.ico" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="Choose what to do with every file whose output already exists. Source files are never overwritten." />
        <Button Click="OnReuse" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True">
            <StackPanel>
                <TextBlock Text="Reuse valid outputs (recommended)" FontWeight="SemiBold" />
                <TextBlock Text="Existing complete AV1 files are verified and kept; damaged or incomplete ones are encoded again." TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Button>
        <Button Click="OnSkip" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Skip these files" FontWeight="SemiBold" />
                <TextBlock Text="Leave the existing outputs as they are and don't process the sources." TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Button>
        <Button Click="OnReplace" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Replace existing outputs" FontWeight="SemiBold" />
                <TextBlock Text="Encode again and overwrite the existing OUTPUT files after verification." TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Button>
        <Button Click="OnNumber" HorizontalContentAlignment="Left" Margin="0,0,0,14" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Keep both" FontWeight="SemiBold" />
                <TextBlock Text="Write new outputs with a number: Movie (2).mkv" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Button>
        <Button Content="Cancel — don't start" IsCancel="True" HorizontalAlignment="Right" Width="170" Click="OnCancel" />
    </StackPanel>
</Window>
