<Window x:Class="AV1Studio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AV1 Studio" Icon="pack://application:,,,/AV1Studio;component/Assets/av1studio.ico" Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Width="100" Click="OnClose" />
        </StackPanel>
        <TabControl>
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,14,8,8">
                        <DockPanel Margin="0,0,0,16">
                            <Image DockPanel.Dock="Left" Source="pack://application:,,,/AV1Studio;component/Assets/av1studio.png" Width="72" Height="72" Margin="0,0,16,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold" />
                                <TextBlock x:Name="DescText" Foreground="{StaticResource SubtleText}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="POWERED BY" Style="{StaticResource CardTitle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://ffmpeg.org/" RequestNavigate="OnLink">FFmpeg</Hyperlink> (LGPL/GPL, depending on the build) ·
                            <Hyperlink NavigateUri="https://gitlab.com/AOMediaCodec/SVT-AV1" RequestNavigate="OnLink">SVT-AV1</Hyperlink> (BSD-3-Clause-Clear) ·
                            <Hyperlink NavigateUri="https://github.com/alexheretic/ab-av1" RequestNavigate="OnLink">ab-av1</Hyperlink> (MIT)
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="These tools are not included with AV1 Studio. They are installed separately or downloaded from their official sources and are covered by their own licenses. VMAF by Netflix (BSD-2-Clause-Patent)." />
                        <TextBlock Text="LICENSE" Style="{StaticResource CardTitle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                            AV1 Studio is open-source software released under the MIT License. See the LICENSE file in the
                            <Hyperlink x:Name="RepoLink" RequestNavigate="OnLink">project repository</Hyperlink>.
                        </TextBlock>
                        <TextBlock Text="THIS PC" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding SystemInfo.Summary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ToolsSummary}" TextWrapping="Wrap" Foreground="{StaticResource SubtleText}" Margin="0,0,0,16" />
                        <TextBlock Text="DATA FOLDER" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Settings, queue, logs and downloaded tools." />
                        <Button Content="Open data folder" Click="OnDataFolder" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Attach this report when reporting a problem. It lists your system, tools and settings, without your user name, computer name or personal folders." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy to clipboard" Click="OnCopy" Margin="0,0,8,0" />
                        <Button Content="Save as…" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,0" />
                        <Button Content="Refresh" Click="OnRefresh" />
                    </StackPanel>
                    <TextBox x:Name="DiagBox" Style="{StaticResource MonoBox}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
