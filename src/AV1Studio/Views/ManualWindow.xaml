<Window x:Class="AV1Studio.Views.ManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AV1Studio.Views"
        xmlns:m="clr-namespace:AV1Studio.Models"
        Title="Manual AV1 settings — AV1 Studio" Icon="pack://application:,,,/AV1Studio;component/Assets/av1studio.ico" Width="1240" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <v:EnumEqualsConverter x:Key="Eq" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="18,12" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" CornerRadius="6" Padding="10,4" Background="{StaticResource PrimaryButton}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="MANUAL AV1 · FULL CONTROL" Foreground="White" FontWeight="Bold" />
                </Border>
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Width="100" Click="OnClose" />
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"
                           Text="Encodes directly with FFmpeg and the selected AV1 encoder. Changes are saved automatically and apply to files you add next." />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18,12,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Reset to defaults" Command="{Binding ResetManualCommand}" Padding="10,3" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Show" Style="{StaticResource Label}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Basic" GroupName="level"
                                         IsChecked="{Binding ManualLevel, Converter={StaticResource Eq}, ConverterParameter=Basic}"
                                         ToolTip="Essential settings only" />
                            <RadioButton Style="{StaticResource Segment}" Content="Advanced" GroupName="level"
                                         IsChecked="{Binding ManualLevel, Converter={StaticResource Eq}, ConverterParameter=Advanced}"
                                         ToolTip="Adds filters, colour tags, keyframes, film grain, tiles and threading" />
                            <RadioButton Style="{StaticResource Segment}" Content="Expert" GroupName="level"
                                         IsChecked="{Binding ManualLevel, Converter={StaticResource Eq}, ConverterParameter=Expert}"
                                         ToolTip="Adds raw SVT-AV1 parameters and extra FFmpeg options" />
                        </StackPanel>
                    </DockPanel>

                    <!-- VIDEO -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VIDEO" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ManualEncoderChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Manual.Encoder}" Width="330" HorizontalAlignment="Left"
                                          ToolTip="Encoders available on this PC. See Settings › CPU &amp; Hardware for details." />
                                <v:HelpTip Text="{x:Static v:Tips.Hardware}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <TextBlock Text="{Binding UnavailableEncodersText}" Style="{StaticResource Hint}" Margin="190,-6,0,10"
                                       Visibility="{Binding UnavailableEncodersText, Converter={StaticResource NotEmptyVis}}" />
                            <TextBlock Text="{Binding EncoderKindText}" Style="{StaticResource Hint}" Margin="190,-6,0,10" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="{Binding QualityName, Mode=OneWay}" /><Run Text=" (quality)" /></TextBlock>
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="10,0,0,0" Text="{Binding Manual.Quality, Converter={StaticResource NullableNum}, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{Binding QualityHelp}" />
                                <v:HelpTip DockPanel.Dock="Right" Text="{x:Static v:Tips.Crf}" />
                                <Slider Minimum="{Binding QualityMin}" Maximum="{Binding QualityMax}" Value="{Binding Manual.Quality}" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="{Binding QualityHelp}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="190,-6,0,10"
                                       Text="Lower values give higher quality and larger files. Use Preview to compare." />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Preset" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PresetChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.Preset}"
                                          Width="330" HorizontalAlignment="Left"
                                          ToolTip="{x:Static v:Tips.Preset}" />
                                <v:HelpTip Text="{x:Static v:Tips.Preset}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Bit depth" Style="{StaticResource FieldLabel}" />
                                <RadioButton Content="10-bit (recommended)" GroupName="bd" Margin="0,0,16,0"
                                             IsChecked="{Binding Manual.BitDepth, Converter={StaticResource Eq}, ConverterParameter=Bit10}"
                                             ToolTip="Reduces banding and is required for HDR. Supported by all modern AV1 players." />
                                <RadioButton Content="8-bit" GroupName="bd" IsChecked="{Binding Manual.BitDepth, Converter={StaticResource Eq}, ConverterParameter=Bit8}"
                                             ToolTip="For older devices. More banding; not suitable for HDR." />
                                <v:HelpTip Text="{x:Static v:Tips.BitDepth}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Manual.Resolution}" Width="200" HorizontalAlignment="Left"
                                          ToolTip="Source keeps the original resolution. 1080p, 1440p and 4K only reduce larger videos and keep the aspect ratio." />
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                            Visibility="{Binding Manual.Resolution, Converter={StaticResource EnumVis}, ConverterParameter=Custom}">
                                    <TextBox Width="64" Text="{Binding Manual.CustomWidth}" /><TextBlock Text=" × " VerticalAlignment="Center" /><TextBox Width="64" Text="{Binding Manual.CustomHeight}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Manual.Fps, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Leave empty to keep the original frame rate, or enter a value such as 24 or 24000/1001." />
                                <TextBlock Text="empty = keep source" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>


                    <!-- GPU WORKLOAD (hardware encoders only) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsHardwareManualEncoder, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <v:HelpTip DockPanel.Dock="Right" Text="{x:Static v:Tips.GpuWorkload}" />
                                <TextBlock Text="GPU ENCODER OPTIONS" Style="{StaticResource CardTitle}" Margin="0" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Leave a field empty to use the encoder default." />
                            <StackPanel Visibility="{Binding ShowHardwareControls, Converter={StaticResource BoolVis}}">
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="B-frames" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding Manual.HwBFrames, Converter={StaticResource NullableNum}, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static v:Tips.BFrames}" />
                                    <v:HelpTip Text="{x:Static v:Tips.BFrames}" HorizontalAlignment="Left" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Lookahead (frames)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding Manual.HwLookahead, Converter={StaticResource NullableNum}, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static v:Tips.Lookahead}" />
                                    <v:HelpTip Text="{x:Static v:Tips.Lookahead}" HorizontalAlignment="Left" />
                                </DockPanel>
                                <StackPanel Visibility="{Binding IsNvenc, Converter={StaticResource BoolVis}}">
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Multipass" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Manual.HwMultipass}" ToolTip="{x:Static v:Tips.Multipass}">
                                            <ComboBoxItem Content="Driver default" Tag="" />
                                            <ComboBoxItem Content="Off (single pass)" Tag="disabled" />
                                            <ComboBoxItem Content="Quarter resolution" Tag="qres" />
                                            <ComboBoxItem Content="Full resolution" Tag="fullres" />
                                        </ComboBox>
                                        <v:HelpTip Text="{x:Static v:Tips.Multipass}" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Adaptive quantization" Style="{StaticResource FieldLabel}" />
                                        <CheckBox Content="Spatial AQ" IsChecked="{Binding Manual.HwSpatialAq}" Margin="0,0,14,0" ToolTip="{x:Static v:Tips.Aq}" />
                                        <CheckBox Content="Temporal AQ" IsChecked="{Binding Manual.HwTemporalAq}" ToolTip="{x:Static v:Tips.Aq}" />
                                        <v:HelpTip Text="{x:Static v:Tips.Aq}" HorizontalAlignment="Left" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                            <DockPanel>
                                <TextBlock Text="Maximum bitrate" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Manual.MaxBitrate, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static v:Tips.MaxBitrate}" />
                                <v:HelpTip Text="{x:Static v:Tips.MaxBitrate}" HorizontalAlignment="Left" />
                                <TextBlock Text="e.g. 8M — empty = no cap" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- FILTERS -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FilterSummary}" Foreground="{StaticResource AccentText}" FontWeight="SemiBold" />
                                <TextBlock Text="FILTERS &amp; PROCESSING" Style="{StaticResource CardTitle}" Margin="0" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="No filters are applied unless you enable them." />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Crop (w:h:x:y)" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="170" HorizontalAlignment="Left" Text="{Binding Manual.Crop, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Removes black bars, e.g. 1920:800:0:140 (width:height:x:y)." />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Deinterlace" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DeinterlaceChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Manual.Deinterlace}" Width="240" HorizontalAlignment="Left"
                                          ToolTip="For interlaced sources such as TV recordings and DVDs." />
                            </DockPanel>
                            <CheckBox Content="Detelecine (inverse telecine for 3:2 pulldown film sources)" IsChecked="{Binding Manual.Detelecine}" Margin="190,0,0,8"
                                      ToolTip="Restores 23.976 fps film from telecined 29.97 fps NTSC video. Use only on telecined sources." />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Denoise" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DenoiseChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Manual.Denoise}" Width="240" HorizontalAlignment="Left"
                                          ToolTip="Reduces noise, which can make files smaller. Also removes fine detail and film grain." />
                            </DockPanel>
                            <CheckBox Content="Deblock (soften blocky compression artefacts in the source)" IsChecked="{Binding Manual.Deblock}" Margin="190,0,0,8"
                                      ToolTip="Smooths blocky, low-quality sources." />
                            <CheckBox Content="Grayscale (remove colour)" IsChecked="{Binding Manual.Grayscale}" Margin="190,0,0,8"
                                      ToolTip="Converts the video to black and white." />
                            <DockPanel Visibility="{Binding ShowExpert, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Custom FFmpeg filters" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Manual.CustomFilter, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                                         ToolTip="Additional FFmpeg video filters, e.g. unsharp=5:5:0.5." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- AUDIO -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="AUDIO" Style="{StaticResource CardTitle}" />
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton Content="Copy (no re-encode)" GroupName="ma" Margin="0,0,16,0" IsChecked="{Binding Manual.AudioMode, Converter={StaticResource Eq}, ConverterParameter=Copy}"
                                             ToolTip="{x:Static v:Tips.AudioCopy}" />
                                <RadioButton Content="Transcode" GroupName="ma" Margin="0,0,16,0" IsChecked="{Binding Manual.AudioMode, Converter={StaticResource Eq}, ConverterParameter=Transcode}" />
                                <RadioButton Content="Remove" GroupName="ma" IsChecked="{Binding Manual.AudioMode, Converter={StaticResource Eq}, ConverterParameter=Remove}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding Manual.AudioMode, Converter={StaticResource EnumVis}, ConverterParameter=Transcode}">
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Codec" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AudioCodecChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Manual.AudioCodec}" Width="240" HorizontalAlignment="Left" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Bitrate" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding Manual.AudioBitrate, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="For example 160k for stereo or 384k for 5.1. Leave empty for the default." />
                                </DockPanel>
                                <CheckBox Content="Downmix to stereo" IsChecked="{Binding Manual.DownmixToStereo}" Margin="190,0,0,8" />
                            </StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Keep languages" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Manual.AudioLanguages, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Language codes separated by commas, e.g. eng,fre. Leave empty to keep all tracks." />
                            </DockPanel>
                            <Button Content="Choose tracks for the selected file individually (Ctrl+T) ›" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Command="{Binding ChooseTracksCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- SUBTITLES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SUBTITLES" Style="{StaticResource CardTitle}" />
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton Content="Copy all" GroupName="ms" Margin="0,0,16,0" IsChecked="{Binding Manual.SubtitleMode, Converter={StaticResource Eq}, ConverterParameter=CopyAll}" />
                                <RadioButton Content="Keep languages" GroupName="ms" Margin="0,0,16,0" IsChecked="{Binding Manual.SubtitleMode, Converter={StaticResource Eq}, ConverterParameter=Languages}" />
                                <RadioButton Content="Remove" GroupName="ms" IsChecked="{Binding Manual.SubtitleMode, Converter={StaticResource Eq}, ConverterParameter=Remove}" />
                            </WrapPanel>
                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding Manual.SubtitleMode, Converter={StaticResource EnumVis}, ConverterParameter=Languages}">
                                <TextBlock Text="Languages" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Manual.SubtitleLanguages, UpdateSourceTrigger=LostFocus}" ToolTip="e.g. eng,fre" />
                            </DockPanel>
                            <CheckBox Content="Forced subtitles only" IsChecked="{Binding Manual.ForcedSubtitlesOnly}" Margin="0,0,0,8"
                                      ToolTip="Keep only forced subtitle tracks." />
                            <DockPanel>
                                <TextBlock Text="Default subtitle language" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding Manual.DefaultSubtitleLanguage, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="For example eng. Leave empty to keep the original default track." />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Languages, titles and flags are kept. Image subtitles (PGS, VobSub) require MKV." />
                        </StackPanel>
                    </Border>

                    <!-- HDR / COLOR -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="HDR / COLOR" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding EncodeTarget.ColorSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                       Visibility="{Binding EncodeTarget.ColorSummary, Converter={StaticResource NotEmptyVis}}" />
                            <RadioButton Content="Preserve source colour &amp; HDR metadata (recommended)" GroupName="hdr" Margin="0,0,0,4"
                                         IsChecked="{Binding Manual.Hdr, Converter={StaticResource Eq}, ConverterParameter=Preserve}"
                                         ToolTip="Keeps the original colour information and HDR10 metadata." />
                            <RadioButton Content="Tone-map HDR to SDR (destructive)" GroupName="hdr" Margin="0,0,0,8"
                                         IsChecked="{Binding Manual.Hdr, Converter={StaticResource Eq}, ConverterParameter=ToneMapToSdr}"
                                         ToolTip="Converts HDR video to SDR for non-HDR displays. HDR information is permanently removed. SDR videos are not affected." />
                            <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="These settings only change the colour tags, not the picture. Use them to correct wrongly tagged sources." />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Colour range" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding RangeChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.ColorRange}" Width="240" HorizontalAlignment="Left"
                                              ToolTip="Limited (TV) is standard for video; Full (PC) for screen recordings." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Colour primaries" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding PrimariesChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.ColorPrimaries}" Width="240" HorizontalAlignment="Left"
                                              ToolTip="BT.709 for HD, BT.2020 for UHD/HDR." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Transfer characteristics" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding TransferChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.ColorTransfer}" Width="240" HorizontalAlignment="Left"
                                              ToolTip="BT.709 (SDR), PQ (HDR10) or HLG." />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Matrix coefficients" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding MatrixChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.ColorMatrix}" Width="240" HorizontalAlignment="Left"
                                              ToolTip="How YUV converts to RGB. Wrong values cause a slight colour tint." />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ADVANCED -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="ADVANCED" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Keyframe interval (GOP)" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding Manual.Keyint, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{x:Static v:Tips.Gop}" />
                                <v:HelpTip Text="{x:Static v:Tips.Gop}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsSvtEncoder, Converter={StaticResource BoolVis}}">
                                <CheckBox Content="Scene-change detection" IsChecked="{Binding Manual.SceneDetection}" Margin="190,0,0,8"
                                          ToolTip="Places keyframes at scene cuts for better quality and seeking." />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Film grain synthesis (0–50)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding Manual.FilmGrain}"
                                             ToolTip="Removes film grain before encoding and recreates it during playback, which saves a lot of space on grainy films. 0 = off; typical values 4–15." />
                                    <CheckBox Content="Denoise before grain analysis" IsChecked="{Binding Manual.FilmGrainDenoise}" Margin="12,0,0,0" VerticalAlignment="Center"
                                              ToolTip="Encodes the denoised picture. Saves more space but can soften detail." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Fast decode (0–2)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding Manual.FastDecode}"
                                             ToolTip="Easier playback on low-power devices, with slightly larger files. 0 = off." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Tune" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding TuneChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Manual.Tune}" Width="240" HorizontalAlignment="Left"
                                              ToolTip="Visual quality (VQ) optimises for perceived quality; PSNR for measured quality." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Tiles (log2 columns / rows)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="50" Text="{Binding Manual.TileColumns}" ToolTip="Faster decoding of 4K video, with slightly larger files. 0 = automatic." />
                                    <TextBlock Text=" / " VerticalAlignment="Center" />
                                    <TextBox Width="50" HorizontalAlignment="Left" Text="{Binding Manual.TileRows}" ToolTip="Tile rows (log2). 0 = encoder decides." />
                                </DockPanel>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding IsHardwareManualEncoder, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}">
                                <TextBlock Text="Maximum bitrate" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Manual.MaxBitrate, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static v:Tips.MaxBitrate}" />
                                <v:HelpTip Text="{x:Static v:Tips.MaxBitrate}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Threads" Style="{StaticResource FieldLabel}" />
                                <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding Manual.Threads}"
                                         ToolTip="Maximum number of encoder threads. 0 = automatic." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- EXPERT -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowExpert, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="EXPERT" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsSvtEncoder, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Custom SVT-AV1 parameters (-svtav1-params)" />
                                <v:HelpTip Text="{x:Static v:Tips.SvtParams}" />
                            </StackPanel>
                            <TextBox Text="{Binding Manual.SvtParams, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                     Visibility="{Binding IsSvtEncoder, Converter={StaticResource BoolVis}}"
                                     ToolTip="key=value pairs, e.g. enable-overlays=1 variance-boost-strength=2." />
                            <TextBlock Text="Extra FFmpeg output options" Margin="0,10,0,4" />
                            <TextBox Text="{Binding Manual.ExtraFfmpegArgs, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="60" FontFamily="{StaticResource MonoFont}"
                                     ToolTip="One name=value pair per line, e.g. metadata=comment=AV1." />
                        </StackPanel>
                    </Border>

                    <!-- OUTPUT + SAFETY -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OUTPUT" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Container" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding OutputContainerChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding OutputContainer}"
                                          Width="240" HorizontalAlignment="Left" ToolTip="{x:Static v:Tips.OutputContainer}" />
                                <v:HelpTip Text="{x:Static v:Tips.OutputContainer}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <WrapPanel Margin="190,0,0,6">
                                <CheckBox Content="Chapters" IsChecked="{Binding Manual.KeepChapters}" Margin="0,0,14,0" />
                                <CheckBox Content="Global metadata (title, artist, date…)" IsChecked="{Binding Manual.KeepGlobalMetadata}" Margin="0,0,14,0" />
                                <CheckBox Content="Attachments (MKV)" IsChecked="{Binding Manual.KeepAttachments}" />
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,4"><Run Text="Destination &amp; naming: " Foreground="{StaticResource SubtleText}" /><Run Text="{Binding OutputSummary, Mode=OneWay}" /></TextBlock>
                            <Button Content="File names and existing files: Settings › Output &amp; folders ›" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Command="{Binding OpenSettingsCommand}" />
                        </StackPanel>
                    </Border>
                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningText}"
                        Visibility="{Binding HasManualWarnings, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ManualWarningsText}" TextWrapping="Wrap" Foreground="{StaticResource WarningText}" />
                </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="FILE USED FOR PREVIEW &amp; COMMAND" Style="{StaticResource CardTitle}" />
                            <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding EncodeTarget}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ModeText, Mode=OneWay}" Foreground="{StaticResource SubtleText}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding TargetHdrBadge}" Style="{StaticResource Hint}" Visibility="{Binding TargetHdrBadge, Converter={StaticResource NotEmptyVis}}" />
                        </StackPanel>
                    </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource CardTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Duration (s)" Style="{StaticResource Label}" />
                            <TextBox Width="60" Text="{Binding PreviewSeconds}" ToolTip="Length of the sample, taken about a third into the file" />
                            <Button Content="Cancel" Command="{Binding CancelPreviewCommand}" DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <Button Command="{Binding EncodePreviewCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="12,4"
                                    ToolTip="Encode a short sample with the current Manual AV1 settings">
                                <TextBlock Text="Encode preview" />
                            </Button>
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="{Binding IsPreviewRunning, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <Grid Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Source" Style="{StaticResource Label}" />
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4">
                                    <Image Source="{Binding SourceFrame}" Stretch="Uniform" MinHeight="60" />
                                </Border>
                                <Button Content="Play source segment" Command="{Binding PlaySourceSegmentCommand}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Encoded" Style="{StaticResource Label}" />
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4">
                                    <Image Source="{Binding EncodedFrame}" Stretch="Uniform" MinHeight="60" />
                                </Border>
                                <Button Content="Play encoded preview" Command="{Binding PlayPreviewCommand}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0" DataContext="{Binding Preview}" Visibility="{Binding Converter={StaticResource NotEmptyVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Output size" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="1" Text="Bitrate" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BitrateKbps, StringFormat={}{0:0} kb/s}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="2" Text="Encoding speed" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}">
                                <Run Text="{Binding EncodeFps, StringFormat={}{0:0.0} fps, TargetNullValue='N/A', Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EncodeTime, StringFormat={}{0:mm\\:ss}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="3" Text="Quality" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QualityText}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="4" Text="Preset / encoder" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}"><Run Text="{Binding Preset, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Encoder, Mode=OneWay}" /></TextBlock>
                            <TextBlock Grid.Row="5" Text="Full file (estimate)" Style="{StaticResource Label}"
                                       ToolTip="Estimated from the sample." />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EstimatedFullSize, Converter={StaticResource Bytes}}" Style="{StaticResource Value}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Copy command" Padding="10,2" Command="{Binding CopyTextCommand}" CommandParameter="{Binding CommandPreview}" />
                            <TextBlock Text="{Binding CommandPreviewTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Style="{StaticResource MonoBox}" Text="{Binding CommandPreview, Mode=OneWay}" MaxHeight="320" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Updates as you change the settings." />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
