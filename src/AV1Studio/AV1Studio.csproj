<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AV1Studio</AssemblyName>
    <AssemblyTitle>AV1 Studio</AssemblyTitle>
    <ApplicationIcon>Assets/av1studio.ico</ApplicationIcon>
    <RootNamespace>AV1Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Fluent ThemeMode is marked experimental in .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release publish: self-contained single exe, no .NET install required. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/av1studio.ico" />
    <Resource Include="Assets/av1studio.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AV1Studio.Tests" />
  </ItemGroup>

</Project>
